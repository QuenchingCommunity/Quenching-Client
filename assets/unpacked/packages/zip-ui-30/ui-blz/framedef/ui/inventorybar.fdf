Frame "SIMPLEFRAME" "SimpleEquipmentPanel" {
    UseActiveContext,
	DecorateFileNames,
	Height 0.2408,
	Width 0.2075,
	SetPoint BOTTOMRIGHT, "SimpleEquipmentInventoryPanel", TOPRIGHT, 0.0, 0.0,

	String "UnitName" INHERITS "TitleTextTemplate" {
		SetPoint TOP, "SimpleEquipmentPanel", TOP, 0.0, -0.015,
		Text "Garek",
	}

	String "UnitClass" INHERITS "TitleTextTemplate" {
		SetPoint TOP, "UnitName", TOP, 0.0, -0.015,

    	Font "MasterFont", 0.009,
		Text "Level 10 Lieutenant",
	}

	Frame "SIMPLEBUTTON" "EquipmentButton_0" INHERITS "EquipmentButtonTemplate" {
		DecorateFileNames,
