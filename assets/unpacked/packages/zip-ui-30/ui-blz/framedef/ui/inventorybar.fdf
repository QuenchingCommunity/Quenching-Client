Frame "BACKDROP" "EquipmentPanelBackdrop" {
	DecorateFileNames,
	Height 0.2408,
	Width 0.2075,
	SetPoint BOTTOMRIGHT, "SimpleEquipmentInventoryPanel", TOPRIGHT, 0.0, 0.0,
    BackdropTileBackground,
    BackdropBackground  "EscMenuBackground",
    BackdropCornerFlags "UL|UR|BL|BR|T|L|B|R",
    BackdropCornerSize  0.02f,
    BackdropBackgroundInsets 0.0021 0.0021 0.0021 0.0021,
    BackdropEdgeFile  "EscMenuBorder",
	BackdropBackgroundSize  0.256,
	BackdropBlendAll,
}

